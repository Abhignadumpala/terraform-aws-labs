terraform {
  required_version = ">= 1.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # Same bucket as network/, different key - two stacks, one shared backend.
  backend "s3" {
    bucket       = "CHANGE-ME-state-bucket" # from bootstrap output
    key          = "compute/terraform.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }
}

provider "aws" {
  region = "us-east-1"
}
